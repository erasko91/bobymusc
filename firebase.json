{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "bobymusc-app",
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", ".firebaserc", ".gitignore", ".git/**",
      "**/.*", "**/node_modules/**", "firebase-debug.log"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "icons/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
