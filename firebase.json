{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "bobymusc-app",
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", ".firebaserc", ".gitignore", ".git/**",
      "**/.*", "**/node_modules/**", "firebase-debug.log", "outils/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
