rules_version = '2';
// BobyMusc : chacun écrit seulement ses données ; seuls les amis acceptés voient les séances.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // « uid » m'a dans sa liste d'amis
    function isFriend(uid) { return exists(/databases/$(database)/documents/users/$(uid)/friends/$(me())); }
    function hasRequest(owner, from) { return exists(/databases/$(database)/documents/users/$(owner)/requests/$(from)); }
    // « uid » n'a pas mis ses séances en privé
    function shares(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.get('private', false) != true; }

    // Rapports d'erreur de l'appli (message technique seulement) : on peut en créer, personne ne les lit
    match /errors/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'stack', 'ua', 'route', 'v', 'at'])
        && request.resource.data.msg is string && request.resource.data.msg.size() < 2000
        && request.resource.data.stack.size() < 4000;
    }

    // Code ami -> identifiant
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Groupes : seuls les membres voient le groupe et ses messages
    match /groups/{gid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == me()
        && me() in request.resource.data.members && request.resource.data.members.size() <= 50;
      // Un membre peut renommer, ajouter des amis, se retirer ; seul le créateur peut passer la main
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.members.size() <= 50
        && (request.resource.data.owner == resource.data.owner || resource.data.owner == me());
      allow delete: if signedIn() && resource.data.owner == me();

      match /messages/{mid} {
        function group() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        allow read: if signedIn() && me() in group().members;
        allow create: if signedIn() && me() in group().members && request.resource.data.uid == me();
        allow delete: if signedIn() && (resource.data.uid == me() || group().owner == me());
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isFriend(uid));
      allow write: if signedIn() && uid == me();

      match /workouts/{wid} {
        allow read: if signedIn() && (uid == me() || (isFriend(uid) && shares(uid)));
        allow write: if signedIn() && uid == me();
        // Un ami peut seulement ajouter/retirer SA réaction
        allow update: if signedIn() && isFriend(uid) && shares(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()]);
      }

      // Programmes, exercices perso, mesures : visibles seulement par soi
      match /private/{doc} {
        allow read, write: if signedIn() && uid == me();
      }

      match /friends/{fid} {
        allow read: if signedIn() && (uid == me() || fid == me());
        allow delete: if signedIn() && (uid == me() || fid == me());
        // Ajout possible seulement s'il existe une demande d'ami
        allow create: if signedIn() && (
          (uid == me() && hasRequest(me(), fid)) ||
          (fid == me() && hasRequest(me(), uid))
        );
      }

      // Demandes d'ami reçues (l'identifiant du document = celui qui demande)
      match /requests/{rid} {
        allow read: if signedIn() && (uid == me() || rid == me());
        allow create: if signedIn() && rid == me() && uid != me();
        allow delete: if signedIn() && (uid == me() || rid == me());
      }
    }
  }
}
